# OS / editor files
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo

# Local backups / archive metadata
_codex_backup_*/
__MACOSX/

# Environment and server-specific configuration
.env
.env.*
upload/config.php
upload/urednik/config.php
upload/admin/config.php

# Runtime logs and generated OpenCart storage data
*.log
storagewiz/cache/*
!storagewiz/cache/index.html
storagewiz/logs/*
!storagewiz/logs/.gitkeep
storagewiz/session/*
!storagewiz/session/index.html
storagewiz/upload/*
!storagewiz/upload/index.html
storagewiz/download/*
!storagewiz/download/index.html
storagewiz/modification/*
!storagewiz/modification/index.html

# Generated image cache
upload/image/cache/
upload/image/webp/

# Uploaded product/media catalog is deployed separately from Git.
upload/image/catalog/**
!upload/image/catalog/**/
!upload/image/catalog/**/index.html

# ACME challenge files are generated by the server
upload/.well-known/acme-challenge/*

# Secrets and local dumps/backups in the project root
/*.pem
/*.key
/*.crt
/*.sql
/*.bak
/*.backup
/*.zip
/*.tar
/*.tar.gz
/*.tgz
/*.gz

# This machine has broad global ignores; keep project source files trackable.
!**/index.html
!**/index.js
