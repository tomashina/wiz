<div class="newsletter-wrap">
<div class="input-group sign-up-field">
<span class="sign-up-respond" id="subscribe-respond{{ module }}"></span>
<input type="email" id="subscribe-module{{ module }}" name="email" class="form-control" placeholder="{{ basel_subscribe_email }}" aria-label="{{ basel_subscribe_email|e }}" />
<span class="input-group-btn">
<a class="btn btn-neutral nowrap" href="#" role="button" onclick="subscribe({{ module }}); return false;"><span class="nowrap">{{ basel_subscribe_btn }}</span></a>
</span>
</div>
</div>
