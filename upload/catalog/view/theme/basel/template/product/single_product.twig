<div class="item single-product">
<div class="image" {% if columns == 'list' %}style="width:{{ img_width }}px"{% endif %}>
    <a href="{{ product.href }}" aria-label="{{ product.name|striptags|e }}">
    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" decoding="async" />
    {% if product.thumb2 %}
    <img class="thumb2" src="{{ product.thumb2 }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" decoding="async" />
    {% endif %}
    </a>
{% if product.price and product.special and salebadge_status %}
    <div class="sale-counter id{{ product.product_id }}"></div>
    <span class="badge sale_badge"><i>{{ product.sale_badge }}</i></span>
{% endif %}
{% if product.new_label %}
    <span class="badge new_badge"><i>{{ basel_text_new }}</i></span>
{% endif %}
{% if ((product.quantity < 1) and (stock_badge_status)) %}
    <span class="badge out_of_stock_badge"><i>{{ basel_text_out_of_stock }}</i></span>
    {% set button_cart = basel_text_out_of_stock %}
{% else %}
	{% set button_cart = default_button_cart %}
{% endif %}
<a class="img-overlay" href="{{ product.href }}" aria-label="{{ product.name|striptags|e }}"></a>
<div class="btn-center catalog_hide"><a class="btn btn-light-outline btn-thin" href="#" aria-label="{{ button_cart|striptags|e }} {{ product.name|striptags|e }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}'); return false;">{{ button_cart }}</a></div>
<div class="icons-wrapper">
<a class="icon is-cart catalog_hide" href="#" aria-label="{{ button_cart|striptags|e }} {{ product.name|striptags|e }}" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ button_cart }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}'); return false;"><span class="global-cart" aria-hidden="true"></span></a>
<a class="icon is_wishlist" href="#" aria-label="{{ button_wishlist|striptags|e }} {{ product.name|striptags|e }}" data-toggle="tooltip" data-placement="{{ tooltip_align }}"  data-title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}'); return false;"><span class="icon-heart" aria-hidden="true"></span></a>
<a class="icon is_compare" href="#" aria-label="{{ button_compare|striptags|e }} {{ product.name|striptags|e }}" onclick="compare.add('{{ product.product_id }}'); return false;" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ button_compare }}"><span class="icon-refresh" aria-hidden="true"></span></a>
<a class="icon is_quickview hidden-xs" href="#" aria-label="{{ basel_button_quickview|striptags|e }} {{ product.name|striptags|e }}" onclick="quickview('{{ product.product_id }}'); return false;" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ basel_button_quickview }}"><span class="icon-magnifier-add" aria-hidden="true"></span></a>
</div> <!-- .icons-wrapper -->
</div><!-- .image ends -->
<div class="caption">
<a class="product-name" href="{{ product.href }}">{{ product.name }}</a>
{% if product.rating %}      
    <div class="rating">
    <span class="rating_stars rating r{{ product.rating }}">
    <i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i>
    </span>
    </div>
{% endif %}



  {% if product.special %}
<br>

    {% if ( product.price_last_30  >  product.special and  product.price_last_30  <  product.price  ) %}

          <span class="price-old">NC zadnjih 30:  {{ product.price_last_30 }}</span>

      {%  else %}

          <span class="price-old">NC zadnjih 30: {{ product.price }}</span>

      {% endif %}



  
   {% endif %}




<div class="price-wrapper">
{% if product.price %}
<div class="price">
  
   {% if product.special %}
   

      <span class="price-new">{{ product.special }} </span>
   {% else %}
 <span>{{ product.price }} </span>
      {% endif %}






    {% if product.tax %}
    <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
    {% endif %}
</div><!-- .price -->
{% endif %}
<p class="description">{% if product.description %}{{ product.description }}{% endif %}</p>
<a class="btn catalog_hide {% if basel_list_style == '6' %}btn-contrast{% else %}btn-outline{% endif %}" href="#" aria-label="{{ button_cart|striptags|e }} {{ product.name|striptags|e }}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}'); return false;"><span class="global-cart" aria-hidden="true"></span>{{ button_cart }}</a>
</div><!-- .price-wrapper -->
<div class="plain-links">
<a class="icon is_wishlist link-hover-color" href="#" onclick="wishlist.add('{{ product.product_id }}'); return false;"><span class="icon-heart" aria-hidden="true"></span> {{ button_wishlist }}</a>
<a class="icon is_compare link-hover-color" href="#" onclick="compare.add('{{ product.product_id }}'); return false;"><span class="icon-refresh" aria-hidden="true"></span> {{ button_compare }}</a>
<a class="icon is_quickview link-hover-color" href="#" onclick="quickview('{{ product.product_id }}'); return false;"><span class="icon-magnifier-add" aria-hidden="true"></span> {{ basel_button_quickview }}</a>
</div><!-- .plain-links-->
</div><!-- .caption-->
{% if product.sale_end_date and countdown_status %}
<script>
  $(function() {
	$(".sale-counter.id{{ product.product_id }}").countdown("{{ product.sale_end_date }}").on('update.countdown', function(event) {
  var $this = $(this).html(event.strftime(''
    + '<div>'
    + '%D<i>{{ basel_text_days }}</i></div><div>'
    + '%H <i>{{ basel_text_hours }}</i></div><div>'
    + '%M <i>{{ basel_text_mins }}</i></div><div>'
    + '%S <i>{{ basel_text_secs }}</i></div></div>'));
});
});
</script>
{% endif %}
</div><!-- .single-product ends -->
